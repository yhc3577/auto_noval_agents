# MongoDB
# 格式: mongodb://用户名:密码@主机:端口/数据库?authSource=认证数据库
MONGODB_URL=mongodb://admin:123456@localhost:27017/novel_db?authSource=admin
MONGODB_DATABASE=novel_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM 配置
# provider 可选: vllm / deepseek / minimax / mimo / openai
LLM_PROVIDER=vllm
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
LLM_BASE_URL=http://localhost:8000/v1

# DeepSeek 配置示例:
# LLM_PROVIDER=deepseek
# LLM_API_KEY=your-deepseek-api-key
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1

# Minimax 配置示例:
# LLM_PROVIDER=minimax
# LLM_API_KEY=your-minimax-api-key
# LLM_MODEL=MiniMax-Text-01
# LLM_BASE_URL=https://api.minimax.chat/v1

# Mimo 配置示例:
# LLM_PROVIDER=mimo
# LLM_API_KEY=your-mimo-api-key
# LLM_MODEL=mimo-v2.5-pro
# LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# FAISS
FAISS_INDEX_PATH=./faiss_indexes

# LangSmith (可选)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key

# 服务端口（避免与 vLLM 8000 冲突）
SERVER_PORT=8080
